{
  "plugins": [
    "https://github.com/kkgams/plugin.fs/releases/download/v0.2.0/plugin.fs.wasm",
    "https://github.com/kkgams/plugin.layout/releases/download/v0.2.0/plugin.layout.wasm",
    "https://github.com/kkgams/plugin.lua/releases/download/v0.2.0/plugin.lua.wasm",
    "https://github.com/kkgams/plugin.respack/releases/download/v0.2.0/plugin.respack.wasm"
  ],
  "ui": {
    "keys": [
      {
        "key": "mod+alt+s",
        "call": ["project.save"],
        "allowInput": true
      },
      {
        "key": "mod+s",
        "call": ["activeView.save"],
        "allowInput": true
      }
    ],
    "theme": {
      "url": "https://github.com/kkgams/theme.the98/releases/download/v0.2.0/theme.the98-0.2.0.zip#themes/the98.css"
    },
    "services": {
      "ui-context": {
        "url": "https://github.com/kkgams/ui-service.context/releases/download/v0.2.0/ui-service.context-0.2.0.zip#ui-plugins/context.js"
      },
      "ui-keys": {
        "url": "https://github.com/kkgams/ui-service.keys/releases/download/v0.2.0/ui-service.keys-0.2.0.zip#ui-plugins/keys.js"
      },
      "ui-toast": {
        "url": "https://github.com/kkgams/ui-service.toast/releases/download/v0.2.0/ui-service.toast-0.2.0.zip#ui-plugins/toast.js"
      },
      "ui-popup": {
        "url": "https://github.com/kkgams/ui-service.popup/releases/download/v0.2.0/ui-service.popup-0.2.0.zip#ui-plugins/popup.js"
      },
      "ui-tooltip": {
        "url": "https://github.com/kkgams/ui-service.tooltip/releases/download/v0.2.0/ui-service.tooltip-0.2.0.zip#ui-plugins/tooltip.js"
      },
      "ui-layout": {
        "url": "https://github.com/kkgams/ui-service.layout/releases/download/v0.2.0/ui-service.layout-0.2.0.zip#ui-plugins/layout.js",
        "config": {
          "layout": "<view-files data-root=\"content\" /><view-bullet setup=\"0:h:70\" data-source=\"content/bulletml/ranger-fan.bulletml.json\" /><view-ng setup=\"1:v:50\" data-source=\"content/gams/graphs/bulletml.ng.json\" />"
        }
      }
    },
    "views": {
      "view-files": {
        "url": "https://github.com/kkgams/view.files/releases/download/v0.2.0/view.files-0.2.0.zip#views/view-files.js",
        "label": "Files",
        "group": "Project",
        "internal": false,
        "config": {
          "open": {
            "ranger-fan.bulletml.json": "view-bullet",
            "aim.bulletml.json": "view-bullet",
            "bulletml.ng.json": "view-ng",
            "json": "view-code",
            "lua": "view-code",
            "md": "view-code",
            "mjs": "view-code",
            "css": "view-code",
            "html": "view-code",
            "default": "files-default"
          }
        }
      },
      "view-bullet": {
        "url": "https://github.com/kkgams/view.bullet/releases/download/v0.2.0/view.bullet-0.2.0.zip#views/view-bullet.js",
        "label": "BulletML",
        "group": "Content",
        "internal": false,
        "config": {
          "defaultSource": "content/bulletml/ranger-fan.bulletml.json"
        }
      },
      "view-ng": {
        "url": "https://github.com/kkgams/view.ng/releases/download/v0.1.0/view.ng-0.1.0.zip#views/view-ng.js",
        "label": "BulletML Pipeline",
        "group": "Content",
        "internal": false,
        "defaultSource": "content/gams/graphs/bulletml.ng.json",
        "config": {
          "background": [
            0.043,
            0.098,
            0.133,
            1
          ],
          "renderer": {
            "node": {
              "width": 180,
              "headerHeight": 30,
              "portRowHeight": 28,
              "padding": 12,
              "radius": 8,
              "borderWidth": 2,
              "portRadius": 6
            },
            "edge": {
              "width": 2,
              "selectedWidth": 4,
              "curveOffset": 48
            },
            "text": {
              "font": "sans-serif",
              "size": 13
            },
            "theme": {
              "node": [
                0.098,
                0.18,
                0.231,
                1
              ],
              "nodeHover": [
                0.133,
                0.251,
                0.322,
                1
              ],
              "nodeSelected": [
                0.114,
                0.306,
                0.4,
                1
              ],
              "nodeBorder": [
                0.275,
                0.424,
                0.518,
                1
              ],
              "header": [
                0.165,
                0.314,
                0.396,
                1
              ],
              "requiredHeader": [
                0.224,
                0.412,
                0.533,
                1
              ],
              "text": [
                0.839,
                0.925,
                0.973,
                1
              ],
              "textMuted": [
                0.565,
                0.682,
                0.753,
                1
              ],
              "port": [
                0.173,
                0.788,
                0.667,
                1
              ],
              "portHover": [
                0.29,
                0.78,
                1,
                1
              ],
              "edge": [
                0.275,
                0.424,
                0.518,
                0.95
              ],
              "edgeSelected": [
                0.29,
                0.78,
                1,
                1
              ],
              "edgePreviewInvalid": [
                0.922,
                0.325,
                0.325,
                1
              ]
            }
          },
          "layout": {
            "gridOriginX": 80,
            "gridOriginY": 58,
            "gridStepX": 240,
            "gridStepY": 112
          }
        }
      },
      "view-ng-node": {
        "url": "https://github.com/kkgams/view.ng-node/releases/download/v0.1.0/view.ng-node-0.1.0.zip#views/view-ng-node.js",
        "label": "Node Editor",
        "internal": true,
        "config": {
          "presets": [
            {
              "name": "BulletML Slots JSON",
              "kind": "code",
              "codePath": "content/gams/nodes/bulletml-slots-json.lua",
              "group": "BulletML",
              "inputs": [
                {
                  "name": "paths",
                  "defaultValue": "[\"content/bulletml/ranger-fan.bulletml.json\"]"
                }
              ],
              "outputs": [
                {
                  "name": "slots_json"
                }
              ]
            },
            {
              "name": "Build BulletML Respack",
              "kind": "code",
              "codePath": "content/gams/nodes/build-bulletml-respack.lua",
              "group": "BulletML",
              "inputs": [
                {
                  "name": "schemaPath",
                  "defaultValue": "\"content/gams/schema/bulletml.rspk.json\""
                },
                {
                  "name": "slotsJson"
                },
                {
                  "name": "outputPath",
                  "defaultValue": "\"build.nosync/content/bulletml.rspk\""
                }
              ],
              "outputs": [
                {
                  "name": "path"
                }
              ]
            }
          ]
        }
      },
      "view-code": {
        "url": "https://github.com/kkgams/view.code/releases/download/v0.2.0/view.code-0.2.0.zip#views/view-code.js",
        "label": "Code",
        "internal": true
      },
      "files-rename": {
        "url": "https://github.com/kkgams/view.files-rename/releases/download/v0.2.0/view.files-rename-0.2.0.zip#views/files-rename.js",
        "label": "Rename File",
        "internal": true
      },
      "files-default": {
        "url": "https://github.com/kkgams/view.files-default/releases/download/v0.2.1/view.files-default-0.2.1.zip#views/files-default.js",
        "label": "File Info",
        "internal": true
      }
    }
  }
}
